# --------------------------------------------------------
# General Aliases
# --------------------------------------------------------
alias l="ls"
alias ll="ls -alh"
alias vi="nvim"
alias awslocal="uvx --from awscli-local awslocal"
alias h="history | fzf"
alias cc="claude"

# bat: better cat with syntax highlighting
if command -v bat &>/dev/null; then
    alias cat="bat --paging=never"
    alias less="bat"
fi

# eza: better ls (git status, icons). Kept off plain 'ls' so muscle-memory flags still work.
if command -v eza &>/dev/null; then
    alias l="eza --group-directories-first"
    alias ll="eza -alh --git --group-directories-first"
    alias lt="eza --tree --level=2 --group-directories-first"
fi

# Disk usage / free space / processes / system monitor
command -v dust &>/dev/null && alias du="dust"
command -v duf &>/dev/null && alias df="duf"
command -v procs &>/dev/null && alias psa="procs"
command -v btm &>/dev/null && alias top="btm"

# zoxide provides 'z' and 'zi' natively after init in .tools
# Optionally replace 'cd' entirely: change zoxide init to --cmd cd in .tools

# Open current directory (platform-aware)
if $IS_MACOS; then
    alias o="open ."
elif $IS_WSL; then
    alias o="wslview ."
else
    alias o="xdg-open ."
fi


# --------------------------------------------------------
# Git Aliases
# --------------------------------------------------------
alias gaa='git add .'
alias gcm='git commit -m'
alias gpsh='git push'
alias gss='git status -s'
alias gs='echo ""; echo "*********************************************"; echo -e "   DO NOT FORGET TO PULL BEFORE COMMITTING"; echo "*********************************************"; echo ""; git status'

# lazygit
if command -v lazygit &>/dev/null; then
    alias lg='lazygit'
fi

# Homebrew formula name aliases (binaries have shorter names)
if command -v delta &>/dev/null; then
    alias git-delta='delta'
fi

if command -v rg &>/dev/null; then
    alias ripgrep='rg'
fi


# --------------------------------------------------------
# macOS only
# --------------------------------------------------------
if $IS_MACOS; then
    alias icloud="cd ~/Library/Mobile\ Documents/com~apple~CloudDocs"
fi
