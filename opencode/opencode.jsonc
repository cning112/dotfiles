{
  "$schema": "https://opencode.ai/config.json",
  "model": "deepseek/deepseek-flash",
  "plugin": [
    "oh-my-opencode-slim",
    "@tarquinen/opencode-dcp",
    "opencode-agent-memory",
    "opencode-handoff",
    "{env:HOME}/.hindsight/coding-agents"
  ],
  "mcp": {
    "gh_grep": {
      "type": "remote",
      "url": "https://mcp.grep.app"
    }
  },
  "agent": {
    "explore": {
      "disable": true
    },
    "general": {
      "disable": true
    }
  },
  "lsp": true
}
