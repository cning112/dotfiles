# Environment variables used by the AI tooling on this machine.
# Copy the keys you need into ~/.env.local (POSIX, already sourced by .commonrc)
# or set them as user environment variables on Windows. Never commit values.

# DeepSeek API key — used by the ccds wrapper and DeepSeek tooling.
DEEPSEEK_API_KEY=

# Morph API key.
MORPH_API_KEY=

# GitHub personal access token (gh CLI / API access).
GITHUB_PERSONAL_ACCESS_TOKEN=
