# NVM (lazy)
# Sourcing nvm.sh costs ~0.35s on every shell start: it is ~4.5k lines and runs
# its own "use default" while loading. Define a stub instead and load the real
# thing on first use. Nothing is added to PATH here, so node/npm/npx keep
# resolving to exactly the same binary as before.
export NVM_DIR="$HOME/.nvm"
if [ -d "$NVM_DIR" ]; then
    nvm() {
        unset -f nvm
        # shellcheck source=/dev/null
        [ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"
        # `command -v` is the portable test here: zsh's `type -t` prints nothing
        # for functions, so it cannot be used to confirm the load succeeded.
        if command -v nvm >/dev/null 2>&1; then
            nvm "$@"
        else
            printf 'nvm: could not load %s/nvm.sh\n' "$NVM_DIR" >&2
            return 1
        fi
    }

    # Completion is only ~100 lines and ships proper zsh support (bashcompinit),
    # so it stays eager; completing `nvm` is what triggers the stub.
    [ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"
fi

# Rust & Cargo
if [ -s "$HOME/.cargo/env" ]; then
    source "$HOME/.cargo/env"
fi

# Conda
export CONDA_PATH="$HOME/miniconda3"
if [ -f "$CONDA_PATH/etc/profile.d/conda.sh" ]; then
    . "$CONDA_PATH/etc/profile.d/conda.sh"
    # Note: run once manually: conda config --set auto_activate_base false
else
    export PATH="$CONDA_PATH/bin:$PATH"
fi

# LM Studio CLI
if [ -d "$HOME/.lmstudio/bin" ]; then
    export PATH="$PATH:$HOME/.lmstudio/bin"
fi

# Homebrew (macOS: /opt/homebrew, Linux: /home/linuxbrew)
if [ -d "/opt/homebrew/bin" ]; then
    export PATH="/opt/homebrew/bin:$PATH"
elif [ -d "/home/linuxbrew/.linuxbrew/bin" ]; then
    export PATH="/home/linuxbrew/.linuxbrew/bin:$PATH"
    export HOMEBREW_PREFIX="/home/linuxbrew/.linuxbrew"
fi

# direnv: per-directory environment variables (.envrc files)
if command -v direnv &>/dev/null; then
    if [ -n "$ZSH_VERSION" ]; then
        eval "$(direnv hook zsh)"
    elif [ -n "$BASH_VERSION" ]; then
        eval "$(direnv hook bash)"
    fi
fi

# Initialize warpify if available (macOS/Warp only)
if command -v warpify &>/dev/null; then
    if [ -n "$ZSH_VERSION" ]; then
        eval "$(warpify init zsh)"
    elif [ -n "$BASH_VERSION" ]; then
        eval "$(warpify init bash)"
    fi
fi

# Initialize zoxide if available
if command -v zoxide &>/dev/null; then
    if [ -n "$ZSH_VERSION" ]; then
        eval "$(zoxide init zsh)"
    elif [ -n "$BASH_VERSION" ]; then
        eval "$(zoxide init bash)"
    fi
fi

# Initialize atuin (local-only shell history DB) if available
# Uses --disable-up-arrow to keep up-arrow as native zsh history line browsing;
# ctrl-r is handed over to atuin for its superior fuzzy history search.
if command -v atuin &>/dev/null; then
    if [ -n "$ZSH_VERSION" ]; then
        eval "$(atuin init zsh --disable-up-arrow)"
    elif [ -n "$BASH_VERSION" ]; then
        eval "$(atuin init bash --disable-up-arrow)"
    fi
fi
